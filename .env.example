# Copy this file to .env and adjust values as needed.
# .env itself is git-ignored so secrets/local overrides never get committed.

# Port the backend Express server listens on inside its container
BACKEND_PORT=5000

# Port the frontend (nginx) container exposes
FRONTEND_PORT=8080

# Comma-separated list of origins allowed to call the API (used by CORS config)
ALLOWED_ORIGINS=http://localhost:8080

# Log level for the backend service
LOG_LEVEL=info
